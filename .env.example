# Copy to .env.local. The public shell also runs with both values blank.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy alternative when a publishable key is unavailable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Not used by the initial shell; never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
