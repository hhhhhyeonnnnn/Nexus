# Copy to .env.local. The public shell also runs with both values blank.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy alternative when a publishable key is unavailable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Not used by the initial shell; never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Site URL used for OAuth redirects (e.g. http://localhost:3000 or https://your-domain.com)
NEXT_PUBLIC_SITE_URL=

# Set to "true" once the corresponding provider is configured in Supabase Dashboard.
# Buttons are disabled (shown as "준비 중") until the flag is enabled.
NEXT_PUBLIC_SOCIAL_GOOGLE=
NEXT_PUBLIC_SOCIAL_KAKAO=
NEXT_PUBLIC_SOCIAL_NAVER=

